# ================= FS.SELLS — ENV =================
# Copy this to .env and fill in your values.
# For local dev you can leave Stripe blank to run in demo mode.

PORT=3000
NODE_ENV=development

# ── Stripe (optional — leave empty for demo mode) ──
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Publishable key is exposed to the browser (safe to share)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# ── Admin ──
# Password to open the product editor. Change this!
ADMIN_PASSWORD=fs-sells-admin-2024

# ── Store ──
STORE_NAME=FS.SELLS
ORDER_EMAIL=orders@fssells.com
CURRENCY=£
CURRENCY_CODE=gbp
SHIPPING_FLAT=12
FREE_SHIPPING_OVER=250

# ── Frontend origin (for CORS / Stripe redirect) ──
# In production set to https://yourdomain.com
FRONTEND_URL=http://localhost:3000
